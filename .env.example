# Vorlage für .env: Diese Datei wird committet, .env nie.
# Erstellen: Copy-Item .env.example .env  und Platzhalter ersetzen.

# PostgreSQL: Name der Datenbank
POSTGRES_DB=wasserrakete
# PostgreSQL: Benutzername
POSTGRES_USER=rakete
# PostgreSQL: Passwort (Geheimnis, hier nur Platzhalter)
POSTGRES_PASSWORD=replace-me

# Debug-Modus: true zeigt /docs und volle Fehlermeldungen.
# Nie true im Produktivbetrieb.
DEBUG=true